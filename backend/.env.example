# Server Port (optional, defaults to 3000 if omitted)
PORT=3000

# MongoDB Connection String (e.g. mongodb://localhost:27017/interview-ai or MongoDB Atlas URI)
MONGO_URI=your_mongodb_connection_string

# JWT Secret Key used to sign authentication tokens
JWT_SECRET=your_jwt_secret

# Google Gemini API Key from Google AI Studio
GOOGLE_GENAI_API_KEY=your_gemini_api_key

# Allowed Frontend URL for CORS (e.g. http://localhost:5173 for local development)
FRONTEND_URL=http://localhost:5173

